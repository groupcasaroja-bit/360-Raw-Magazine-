
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "360 Raw Magazine" }}</title>
  <meta name="description" content="{{ description or 'Culture, fashion, art and the world through 360 Raw Magazine.' }}">
  <style>
    :root {
      --black: #080808;
      --white: #f7f7f4;
      --lime: #c7f000;
      --gray: #a6a6a0;
      --line: #303030;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--black);
      color: var(--white);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    a { color: inherit; text-decoration: none; }

    .topline {
      padding: 9px 5%;
      border-bottom: 1px solid var(--line);
      color: var(--lime);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    header {
      padding: 24px 5% 18px;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      font-size: clamp(30px, 5vw, 58px);
      font-weight: 900;
      letter-spacing: -3px;
      line-height: 1.1;
    }

    .brand span { color: var(--lime); }

    .tagline {
      margin-top: 7px;
      color: var(--gray);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      padding: 15px 5%;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
    }

    nav a:hover, footer a:hover { color: var(--lime); }

    main {
      width: min(1200px, 90%);
      margin: 45px auto;
      min-height: 45vh;
    }

    .eyebrow {
      color: var(--lime);
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    h1, h2, h3 { line-height: 1.15; }

    h1 {
      font-size: clamp(36px, 7vw, 76px);
      letter-spacing: -3px;
    }

    .intro {
      max-width: 700px;
      color: var(--gray);
      font-size: 18px;
    }

    .lime { color: var(--lime); }

    footer {
      padding: 35px 5%;
      border-top: 1px solid var(--line);
      color: var(--gray);
      font-size: 12px;
    }

    .footer-brand {
      color: var(--white);
      font-size: 24px;
      font-weight: 900;
    }

    @media (max-width: 600px) {
      nav { gap: 12px; }
      main { margin: 30px auto; }
      h1 { letter-spacing: -1px; }
    }
  </style>
</head>
<body>
  <div class="topline">Independent perspective · Global culture · Latin America &amp; the Caribbean</div>

  <header>
    <a class="brand" href="/">360 RAW<span>.</span></a>
    <div class="tagline">Culture. Style. The World.</div>
  </header>

  <nav aria-label="Main navigation">
    <a href="/">Latest</a>
    <a href="/culture/">Culture</a>
    <a href="/fashion/">Fashion</a>
    <a href="/entertainment/">Entertainment</a>
    <a href="/luxury/">Luxury</a>
    <a href="/photography/">Photography</a>
    <a href="/world/">World</a>
    <a href="/events/">Events</a>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-brand">360 RAW<span class="lime">.</span> MAGAZINE</div>
    <p>Culture, fashion, art, entertainment, photography and global perspectives.</p>
    <p>© {{ "now" | date("%Y") }} 360 Raw Magazine. All rights reserved.</p>
  </footer>
</body>
</html>

