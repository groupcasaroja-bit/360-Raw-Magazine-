
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "360 Raw Magazine | Culture. Style. The World." }}</title>
  <meta name="description" content="{{ description or 'Culture, fashion, art, entertainment, photography and global events from 360 Raw Magazine.' }}">
  <meta name="theme-color" content="#101010">
  <link rel="stylesheet" href="/styles.css">
  <style>
    :root {
      --black: #101010;
      --white: #f7f7f2;
      --lime: #c8ff00;
      --gray: #aaa;
      --line: #333;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--white);
      color: var(--black);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.5;
    }
    a { color: inherit; text-decoration: none; }
    .masthead {
      background: var(--black);
      color: var(--white);
      padding: 22px 5vw 18px;
      border-bottom: 4px solid var(--lime);
    }
    .topline {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #ccc;
    }
    .brand {
      display: block;
      font-size: clamp(34px, 6vw, 76px);
      line-height: .95;
      font-weight: 900;
      letter-spacing: -4px;
      margin: 24px 0 18px;
    }
    .brand span { color: var(--lime); }
    .navigation {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 24px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .navigation a:hover { color: var(--lime); }
    .wrap { width: min(1240px, 90%); margin: 0 auto; }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 28px;
      padding: 42px 0;
    }
    .hero-main {
      min-height: 430px;
      display: flex;
      align-items: end;
      color: white;
      background:
        linear-gradient(0deg, rgba(0,0,0,.9), rgba(0,0,0,.05)),
        linear-gradient(135deg, #262626, #626262 55%, #c8ff00);
      padding: 34px;
    }
    .hero-copy { max-width: 650px; }
    .eyebrow, .tag {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .hero-main .eyebrow { color: var(--lime); }
    h1 {
      font-size: clamp(38px, 5vw, 68px);
      line-height: .98;
      letter-spacing: -2px;
      margin: 18px 0;
    }
    .dek { max-width: 560px; font-size: 17px; color: #eee; }
    .byline, .meta { font-size: 11px; color: #aaa; }
    .hero-side { border-top: 4px solid var(--black); }
    .side-story { padding: 17px 0; border-bottom: 1px solid #ccc; }
    .side-story .tag, .story-card .tag, .brief-list .tag { color: #555; }
    .side-story h3 { font-size: 22px; line-height: 1.15; margin: 7px 0; }
    .side-story p, .story-card p, .brief-list p { color: #666; font-size: 13px; }
    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      border-bottom: 2px solid var(--black);
      margin: 18px 0 22px;
    }
    .section-head h2 {
      margin: 0 0 10px;
      font-size: 30px;
      letter-spacing: -1px;
    }
    .section-head > a { font-size: 12px; font-weight: bold; margin-bottom: 12px; }
    .story-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 30px 22px;
      padding-bottom: 48px;
    }
    .visual {
      height: 220px;
      background: linear-gradient(135deg, #242424, #777);
      overflow: hidden;
    }
    .visual.fashion { background: linear-gradient(135deg, #272323, #a18d7d); }
    .visual.art, .visual.photography { background: linear-gradient(135deg, #111, #c8ff00); }
    .visual.entertainment { background: linear-gradient(135deg, #353535, #7e1f36); }
    .visual.world, .visual.city { background: linear-gradient(135deg, #555, #b6b6b6); }
    .visual.has-image { background: #ddd; }
    .visual img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .story-card .tag { margin-top: 14px; }
    .story-card h3 { font-size: 23px; line-height: 1.12; margin: 7px 0; }
    .story-card p { margin: 8px 0; }
    .story-card .meta { color: #777; }
    .no-stories { grid-column: 1 / -1; padding: 28px; background: #eee; }
    .feature-band {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
      background: var(--lime);
      padding: 42px;
      margin: 10px 0 48px;
    }
    .feature-band h2 { font-size: clamp(30px, 4vw, 48px); line-height: 1; margin: 12px 0 0; }
    .feature-band p { max-width: 520px; }
    .feature-band a { display: inline-block; font-weight: 800; border-bottom: 2px solid; padding-bottom: 4px; }
    .lower-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 44px;
      padding-bottom: 60px;
    }
    .brief-list { list-style: none; padding: 0; margin: 0; }
    .brief-list li { border-bottom: 1px solid #ccc; padding: 14px 0; }
    .brief-list h3 { font-size: 19px; margin: 5px 0; }
    .newsletter { background: var(--black); color: white; padding: 30px; align-self: start; }
    .newsletter .eyebrow { color: var(--lime); }
    .newsletter h2 { font-size: 32px; line-height: 1.05; margin: 12px 0; }
    .newsletter p, .newsletter small { color: #ccc; font-size: 12px; }
    .newsletter form { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 12px; }
    .newsletter input { flex: 1 1 180px; min-width: 0; padding: 13px; border: 0; }
    .newsletter button { padding: 13px 16px; background: var(--lime); border: 0; font-weight: 800; cursor: pointer; }
    footer { background: var(--black); color: white; padding: 28px 5vw; }
    .footer-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    footer p { font-size: 11px; color: #aaa; }
    @media (max-width: 760px) {
      .brand { letter-spacing: -2px; }
      .hero-grid, .feature-band, .lower-grid { grid-template-columns: 1fr; }
      .hero-main { min-height: 350px; padding: 24px; }
      .story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 14px; }
      .visual { height: 170px; }
      .story-card h3 { font-size: 19px; }
      .feature-band { padding: 28px; }
      .topline { font-size: 9px; }
    }
    @media (max-width: 460px) {
      .story-grid { grid-template-columns: 1fr; }
      .visual { height: 230px; }
      .section-head h2 { font-size: 25px; }
    }
  </style>
</head>
<body>
  <header class="masthead">
    <div class="topline">
      <span>Independent culture &amp; lifestyle</span>
      <span>United States · Latin America · Caribbean</span>
    </div>
    <a class="brand" href="/">360 RAW<span>.</span></a>
    <nav class="navigation" aria-label="Main navigation">
      <a href="/">Latest</a>
      <a href="/#culture">Culture</a>
      <a href="/#culture">Fashion</a>
      <a href="/#culture">Entertainment</a>
      <a href="/#culture">Luxury</a>
      <a href="/#culture">Photography</a>
      <a href="/#culture">World</a>
      <a href="/#events">Events</a>
    </nav>
  </header>

  {{ content | safe }}

  <footer>
    <div class="footer-inner">
      <div>
        <a class="brand" href="/">360 RAW<span>.</span></a>
        <p>Culture. Style. The World.</p>
      </div>
      <div>
        <p>Independent perspective. Global stories.</p>
        <p>© {{ "now" | date("%Y") }} 360 Raw Magazine</p>
      </div>
    </div>
  </footer>
</body>
</html>
