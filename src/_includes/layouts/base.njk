
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or '360 Raw Magazine: arte, cultura, entretenimiento, tecnología e innovación.' }}">
  <title>{{ title or "360 Raw Magazine" }}</title>
  <style>
    :root {
      --black: #080808;
      --white: #ffffff;
      --green: #c7f000;
      --gray: #bdbdbd;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--white);
      color: var(--black);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    a { color: inherit; text-decoration: none; }

    .topbar {
      background: var(--black);
      color: var(--white);
      padding: 12px 6%;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    header {
      padding: 28px 6%;
      border-bottom: 1px solid #e5e5e5;
    }

    .logo {
      font-size: clamp(30px, 5vw, 54px);
      font-weight: 900;
      letter-spacing: -2px;
      line-height: 1.1;
    }

    .logo span { color: #86a900; }

    .tagline {
      margin-top: 8px;
      color: #555;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      padding: 14px 6%;
      border-bottom: 3px solid var(--black);
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
    }

    nav a:hover { color: #769500; }

    main {
      width: min(1120px, 88%);
      margin: 36px auto;
      min-height: 50vh;
    }

    .section-label {
      display: inline-block;
      margin-bottom: 18px;
      padding: 5px 10px;
      background: var(--green);
      color: var(--black);
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    h1, h2, h3 { line-height: 1.2; }

    h1 { font-size: clamp(30px, 5vw, 48px); }

    img { max-width: 100%; height: auto; }

    footer {
      margin-top: 60px;
      padding: 32px 6%;
      background: var(--black);
      color: var(--white);
    }

    footer p { color: var(--gray); font-size: 13px; }

    @media (max-width: 600px) {
      nav { gap: 12px; }
      main { width: 90%; margin-top: 24px; }
    }
  </style>
</head>
<body>
  <div class="topbar">Arte · Cultura · Entretenimiento · Tecnología</div>

  <header>
    <a class="logo" href="/">360 RAW<span> MAGAZINE</span></a>
    <div class="tagline">Perspectivas globales · Voces de Latinoamérica y el Caribe</div>
  </header>

  <nav aria-label="Navegación principal">
    <a href="/">Inicio</a>
    <a href="/categories/arte/">Arte</a>
    <a href="/categories/entretenimiento/">Entretenimiento</a>
    <a href="/categories/tecnologia/">Tecnología</a>
    <a href="/categories/cultura/">Cultura</a>
    <a href="/about/">Nosotros</a>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <a class="logo" href="/">360 RAW<span> MAGAZINE</span></a>
    <p>Una plataforma de contenidos digitales para Estados Unidos, Latinoamérica y el Caribe.</p>
    <p>© {{ "now" | dateDisplay }} 360 Raw Magazine. Todos los derechos reservados.</p>
  </footer>
</body>
</html>

